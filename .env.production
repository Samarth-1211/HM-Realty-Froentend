# Production build values. Committed on purpose (no secrets here — these are
# all public, and Vite bakes VITE_* into the static bundle at build time).
#
# This file exists because the Cloudflare git-connected build clones the repo,
# where .env is gitignored — so without it every VITE_* is undefined and
# API_BASE_URL silently falls back to http://localhost:3000 (src/lib/constants.ts).
#
# Vite precedence in production: .env.production.local > .env.local >
# .env.production > .env. `npm run dev` does NOT read this file, so local
# development keeps using .env (localhost:3000).
VITE_API_BASE_URL=https://rcrm.tdmgroups.com

VITE_REFRESH_INTERVAL_MS=20000
VITE_QUERY_STALE_TIME_MS=10000
VITE_QUERY_RETRY_COUNT=1
VITE_MUTATION_RETRY_COUNT=0

VITE_APP_NAME=HM Realty
VITE_APP_FULL_NAME=HM Realty CRM
VITE_APP_LEGAL_NAME=The Harshit Mehta Firm
VITE_APP_TAGLINE=Your Dreams, Our Responsibility
VITE_APP_DESCRIPTION=HM Realty CRM — leads, teams and organizations in one place.
VITE_APP_MARKETING_BLURB=The Exclusive CRM built for The Harshit Mehta Firm — engineered to streamline operations, strengthen client relationships and keep every deal moving, from first enquiry to closed sale.
